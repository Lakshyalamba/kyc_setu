generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  OFFICER
  OFFICER_LEAD
  AUDITOR
  /// Non-human account used by the verification worker to mint internal document links.
  AI_SERVICE
}

enum UserKind {
  HUMAN
  SERVICE
}

enum KycStatus {
  DRAFT
  CONSENT_GIVEN
  PERSONAL_SUBMITTED
  DOCS_UPLOADED
  DOCS_EXTRACTED
  SELFIE_CAPTURED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMIT_REQUESTED
  EXPIRED
}

/// UI/progress step, tracked separately from the status state machine.
enum KycStep {
  CONTACT
  CONSENT
  PERSONAL
  DOCUMENTS
  SELFIE
  REVIEW
}

enum OtpChannel {
  SMS
  EMAIL
}

enum DocumentType {
  PAN
  AADHAAR_FRONT
  AADHAAR_BACK
  SIGNATURE
}

enum SignedUrlPurpose {
  CUSTOMER_PREVIEW
  OFFICER_REVIEW
  /// Short-lived link for the AI service to read a document; only issued to a SERVICE user.
  AI_INTERNAL
}

enum ExtractionStatus {
  PENDING
  OK
  LOW_QUALITY
  PARSE_FAILED
  WRONG_DOCUMENT
  ERROR
  /// Nothing to extract (e.g. a signature). Counts as finished.
  SKIPPED
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH
}

enum RiskTrigger {
  AUTO
  RECOMPUTE
}

enum BiometricSource {
  /// Written by the selfie / face-match pipeline (Phase 4).
  PIPELINE
  /// Written by the dev-only signal injector. Ignored when NODE_ENV=production.
  DEV_INJECTED
}

enum ActorType {
  USER
  SYSTEM
  AI
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  kind         UserKind @default(HUMAN)
  createdAt    DateTime @default(now())

  kycSessions   KycSession[]
  otpChallenges OtpChallenge[]
  signedUrls    SignedUrlIssue[]

  @@map("users")
}

model KycSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  status    KycStatus @default(DRAFT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime

  currentStep    KycStep   @default(CONTACT)
  completedSteps KycStep[] @default([])
  /// Problems for officers to look at, e.g. EXTRACTION_WRONG_DOCUMENT, EXTRACTION_ERROR.
  flags          String[]  @default([])

  /// Sensitive fields (panNumber, aadhaarNumber) are stored AES-256-GCM encrypted; see packages/shared pii crypto.
  personalDetails Json? @db.JsonB

  consentVersionId  String?   @db.Uuid
  consentAcceptedAt DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  consentVersion ConsentVersion? @relation(fields: [consentVersionId], references: [id], onDelete: Restrict)
  otpChallenges  OtpChallenge[]
  documents      Document[]
  riskAssessments  RiskAssessment[]
  biometricSignals BiometricSignal[]

  // Note: a partial unique index on (userId) WHERE status NOT IN (APPROVED, REJECTED, EXPIRED)
  // enforces "one active session per user". Prisma can't express it; it lives in the migration SQL.
  @@index([userId])
  @@index([status])
  @@map("kyc_sessions")
}

model ConsentVersion {
  id            String   @id @default(uuid()) @db.Uuid
  /// semver, e.g. 1.0.0
  version       String   @unique
  bodyMarkdown  String   @db.Text
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  sessions KycSession[]

  @@map("consent_versions")
}

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  sessionId   String     @db.Uuid
  channel     OtpChannel
  destination String
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  verifiedAt  DateTime?
  createdAt   DateTime   @default(now())

  user    User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  session KycSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([sessionId])
  @@map("otp_challenges")
}

/// An uploaded identity document. The file itself lives AES-256-GCM encrypted in object storage;
/// the per-document data key is wrapped by the KMS and stored here (envelope encryption).
/// "Active" means replacedById IS NULL. A replaced row points at its replacement; a deleted row
/// points at itself. Rows and ciphertext are never removed.
model Document {
  id         String       @id @default(uuid()) @db.Uuid
  sessionId  String       @db.Uuid
  type       DocumentType
  storageKey String
  mimeType   String
  sizeBytes  Int
  /// SHA-256 of the plaintext, hex.
  sha256     String
  uploadedAt DateTime     @default(now())
  replacedById String?    @db.Uuid

  encryptedDataKey Bytes
  kmsKeyId         String
  iv               Bytes
  authTag          Bytes

  session         KycSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  replacedBy      Document?        @relation("DocumentReplacement", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces        Document[]       @relation("DocumentReplacement")
  signedUrlIssues SignedUrlIssue[]
  extraction      Extraction?

  // Partial unique index (sessionId, type) WHERE replacedById IS NULL and a DEFERRABLE self-FK
  // live in the migration SQL; Prisma can't express them.
  @@index([sessionId, type])
  @@map("documents")
}

/// Result of running OCR/parsing on one document. Written only by the Node worker; the AI service
/// is a stateless function. Sensitive values never sit in plaintext: the PAN number inside `fields`
/// is field-encrypted, the full OCR text is envelope-encrypted, and the indexed columns hold a keyed
/// hash (PAN) and the last four digits (Aadhaar).
model Extraction {
  id         String           @id @default(uuid()) @db.Uuid
  documentId String           @unique @db.Uuid
  status     ExtractionStatus @default(PENDING)

  fields         Json? @db.JsonB
  qualityMetrics Json? @db.JsonB
  modelVersions  Json? @db.JsonB
  timings        Json? @db.JsonB

  /// Full OCR text, AES-256-GCM envelope encrypted (same scheme as documents).
  rawTextEncrypted Bytes?
  encryptedDataKey Bytes?
  kmsKeyId         String?
  iv               Bytes?
  authTag          Bytes?

  /// HMAC-SHA256(PAN) for equality checks without storing the PAN in the clear.
  panNumberHmac      String?
  aadhaarNumberLast4 String?

  attempt      Int       @default(0)
  errorMessage String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([panNumberHmac])
  @@index([aadhaarNumberLast4])
  @@index([status])
  @@map("extractions")
}

/// One row per signed-URL grant. The row id is the public part of the URL token.
model SignedUrlIssue {
  id             String           @id @default(uuid()) @db.Uuid
  documentId     String           @db.Uuid
  issuedToUserId String           @db.Uuid
  purpose        SignedUrlPurpose
  expiresAt      DateTime
  issuedAt       DateTime         @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [issuedToUserId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@map("signed_url_issues")
}

/// The result of one run of the rule-based risk engine. Append-only: a re-run (e.g. after a resubmission)
/// is a NEW row, and the current assessment is the newest by createdAt. A DB trigger rejects UPDATE/DELETE.
/// Nothing here contains names, dates of birth or document numbers: `inputsSnapshot` is derived numbers
/// and booleans only.
model RiskAssessment {
  id             String      @id @default(uuid()) @db.Uuid
  sessionId      String      @db.Uuid
  score          Int
  band           RiskBand
  /// The band the score alone gives; `band` can be higher because of band floors / hard-fail.
  rawBand        RiskBand
  hardFail       Boolean
  triggeredRules Json        @db.JsonB
  bandFloors     Json        @db.JsonB
  appliedRules   String[]
  skippedRules   Json        @db.JsonB
  engineVersion  String
  inputsSnapshot Json        @db.JsonB
  trigger        RiskTrigger
  /// The officer who asked for a recompute (null for automatic runs).
  triggeredById  String?     @db.Uuid
  createdAt      DateTime    @default(now())

  session KycSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt])
  @@map("risk_assessments")
}

/// Face-match and liveness outputs for a session. Phase 4 (selfie capture + face match) owns writing real
/// ones; until then only the dev-only injector writes (source DEV_INJECTED). The risk worker reads the newest.
model BiometricSignal {
  id                String          @id @default(uuid()) @db.Uuid
  sessionId         String          @db.Uuid
  source            BiometricSource
  /// Similarity between the selfie and the ID photo, 0..1. Null if not computed.
  faceMatchScore    Float?
  faceMatchModel    String?
  /// Null if the liveness check did not run.
  livenessPassed    Boolean?
  createdAt         DateTime        @default(now())

  session KycSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt])
  @@map("biometric_signals")
}

/// Append-only: no updatedAt, never updated or deleted by application code.
/// actorId is intentionally NOT a foreign key so the log survives user deletion
/// and can record failed logins for unknown users.
model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorId    String?   @db.Uuid
  actorType  ActorType
  action     String
  entityType String
  entityId   String
  metadata   Json      @default("{}") @db.JsonB
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
