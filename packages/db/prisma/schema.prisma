generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  OFFICER
  OFFICER_LEAD
  AUDITOR
}

enum KycStatus {
  DRAFT
  CONSENT_GIVEN
  PERSONAL_SUBMITTED
  DOCS_UPLOADED
  SELFIE_CAPTURED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMIT_REQUESTED
  EXPIRED
}

/// UI/progress step, tracked separately from the status state machine.
enum KycStep {
  CONTACT
  CONSENT
  PERSONAL
  DOCUMENTS
  SELFIE
  REVIEW
}

enum OtpChannel {
  SMS
  EMAIL
}

enum ActorType {
  USER
  SYSTEM
  AI
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())

  kycSessions   KycSession[]
  otpChallenges OtpChallenge[]

  @@map("users")
}

model KycSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  status    KycStatus @default(DRAFT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime

  currentStep    KycStep   @default(CONTACT)
  completedSteps KycStep[] @default([])

  /// Sensitive fields (panNumber, aadhaarNumber) are stored AES-256-GCM encrypted; see packages/shared pii crypto.
  personalDetails Json? @db.JsonB

  consentVersionId  String?   @db.Uuid
  consentAcceptedAt DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  consentVersion ConsentVersion? @relation(fields: [consentVersionId], references: [id], onDelete: Restrict)
  otpChallenges  OtpChallenge[]

  // Note: a partial unique index on (userId) WHERE status NOT IN (APPROVED, REJECTED, EXPIRED)
  // enforces "one active session per user". Prisma can't express it; it lives in the migration SQL.
  @@index([userId])
  @@index([status])
  @@map("kyc_sessions")
}

model ConsentVersion {
  id            String   @id @default(uuid()) @db.Uuid
  /// semver, e.g. 1.0.0
  version       String   @unique
  bodyMarkdown  String   @db.Text
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  sessions KycSession[]

  @@map("consent_versions")
}

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  sessionId   String     @db.Uuid
  channel     OtpChannel
  destination String
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  verifiedAt  DateTime?
  createdAt   DateTime   @default(now())

  user    User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  session KycSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([sessionId])
  @@map("otp_challenges")
}

/// Append-only: no updatedAt, never updated or deleted by application code.
/// actorId is intentionally NOT a foreign key so the log survives user deletion
/// and can record failed logins for unknown users.
model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorId    String?   @db.Uuid
  actorType  ActorType
  action     String
  entityType String
  entityId   String
  metadata   Json      @default("{}") @db.JsonB
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
