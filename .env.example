# Copy to .env (git-ignored). All values below are local-dev placeholders.

NODE_ENV=development

# --- Postgres (docker-compose) ---
DATABASE_URL=postgresql://kyc:kyc@localhost:5433/kyc_setu?schema=public
# Used only by `pnpm test` (separate DB created by infra/postgres-init.sql)
TEST_DATABASE_URL=postgresql://kyc:kyc@localhost:5433/kyc_setu_test?schema=public

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- MinIO / S3 ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kyc-documents

# --- API ---
API_PORT=4000
# >= 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN_SECONDS=86400
# 32 random bytes, base64. Encrypts PAN/Aadhaar at rest. Generate with: openssl rand -base64 32
PII_ENCRYPTION_KEY=ZGV2LW9ubHktcGlpLWtleS1jaGFuZ2UtbWUtMDEyMzQ=
# --- Documents (Phase 2) ---
# Public base URL of the API, used to build signed /files/<token> links
API_PUBLIC_URL=http://localhost:4000
# `local` = dev-only KMS using the master key below. Refused when NODE_ENV=production.
KMS_PROVIDER=local
# 32 random bytes, base64. Generate with: openssl rand -base64 32
KMS_LOCAL_MASTER_KEY=ZGV2LW9ubHkta21zLW1hc3Rlci1rZXktMDEyMzQ1Njc=
# >= 32 chars. Signs the 5-minute document URLs. Generate with: openssl rand -base64 48
FILE_URL_SECRET=dev-only-file-url-secret-change-me-0123456789
WEB_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
# Shared secret between the Node worker and the AI service (>= 32 chars). openssl rand -base64 48
AI_INTERNAL_KEY=dev-internal-key-change-me-0123456789
# Seconds before each retry of a failed extraction: 3 retries after the first attempt
EXTRACTION_BACKOFF_SECONDS=10,60,300
# Raw OCR text (encrypted) is kept this long; the cleanup job exists but is not scheduled yet
OCR_RAW_TEXT_RETENTION_DAYS=90

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
